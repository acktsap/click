{
  "manifest_version": 3,
  "name": "Click Script",
  "version": "1.0.0",
  "description": "Run a script in the active tab when the extension button is clicked.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Run script",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
